# AI Services configuration (ADR-0006). No secrets: Claude uses the local Claude Code login.
# The service reads real environment variables; export these or pass them to the process.
AI_EXTRACTION_MODE=model
AI_PROVIDERS=claude,ollama
CLAUDE_MODEL=claude-opus-5-5
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
AI_PROVIDER_TIMEOUT_SECONDS=120
